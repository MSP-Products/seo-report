<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "My Social Practice — SEO Reports Admin" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="MSP SEO Reports">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="font-sans antialiased bg-slate-50 text-slate-800">
    <% if current_admin_user %>
      <div data-controller="mobile-nav" class="flex h-screen flex-col overflow-hidden">
        <div class="flex shrink-0 items-center gap-3 border-b border-slate-200 bg-white px-4 py-3 md:hidden">
          <button type="button" data-action="click->mobile-nav#open" class="text-slate-500 hover:text-slate-700" aria-label="Open menu">
            <%= report_icon(:menu, css_class: "size-6") %>
          </button>
          <div class="flex size-8 items-center justify-center rounded-lg bg-teal-primary text-xs font-bold text-white">MSP</div>
          <span class="font-semibold text-slate-900">My Social Practice</span>
        </div>

        <div class="flex min-h-0 flex-1">
          <div data-mobile-nav-target="backdrop" data-action="click->mobile-nav#close"
            class="fixed inset-0 z-30 hidden bg-slate-900/40 md:hidden"></div>
          <%= render "shared/admin_sidebar" %>
          <main class="min-w-0 flex-1 overflow-y-auto p-4 md:p-8">
            <%= yield %>
          </main>
        </div>
      </div>
    <% else %>
      <%= yield %>
    <% end %>
  </body>
</html>

