<%# locals: connection (AgencyConnection) %>
<% display = AgencyConnection::DISPLAY.fetch(connection.service) %>
<div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
  <div class="flex items-center justify-between">
    <div class="flex items-center gap-3">
      <div class="flex size-9 items-center justify-center rounded-lg <%= display[:badge_class] %> text-sm font-bold text-white">
        <%= display[:letter] %>
      </div>
      <p class="font-medium text-slate-900"><%= display[:name] %></p>
    </div>
    <span class="size-2 rounded-full <%= connection.status_dot_class %>"></span>
  </div>

  <div class="mt-4 flex items-center justify-between">
    <div>
      <p class="text-sm text-slate-700"><%= connection.status_label %></p>
      <% if connection.last_verified_at.present? %>
        <p class="text-xs text-slate-500">Last verified <%= time_ago_in_words(connection.last_verified_at) %> ago</p>
      <% end %>
    </div>

    <% if connection.credential_fields.any? %>
      <%= link_to "Edit", edit_connection_path(connection.service), class: "text-sm font-medium text-teal-dark hover:underline" %>
    <% end %>
  </div>
</div>
