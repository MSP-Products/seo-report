<%# Sidebar nav shell, shown on every authenticated admin page (see layouts/application.html.erb). %>
<aside data-mobile-nav-target="panel"
  class="fixed inset-y-0 left-0 z-40 flex h-full w-64 shrink-0 -translate-x-full flex-col border-r border-slate-200 bg-white transition-transform duration-200 ease-out md:static md:w-60 md:translate-x-0">
  <div class="flex items-center gap-2.5 border-b border-slate-200 px-5 py-4">
    <div class="flex size-9 items-center justify-center rounded-lg bg-teal-primary text-sm font-bold text-white">MSP</div>
    <span class="flex-1 font-semibold text-slate-900">My Social Practice</span>
    <button type="button" data-action="click->mobile-nav#close" class="text-slate-400 hover:text-slate-600 md:hidden" aria-label="Close menu">
      <%= report_icon(:x, css_class: "size-5") %>
    </button>
  </div>

  <nav class="flex-1 space-y-1 px-3 py-4">
    <% [
      [:dashboard, "Dashboard", dashboard_path, "dashboard"],
      [:clients, "Clients", clients_path, "clients"],
      [:report_log, "Report Log", report_log_path, "report_logs"],
      [:connections, "Connections", connections_path, "connections"]
    ].each do |key, label, path, controller| %>
      <% active = controller_name == controller %>
      <%= link_to path, class: "flex items-center gap-3 rounded-lg px-3 py-2 text-sm #{active ? "bg-teal-primary/10 font-medium text-teal-dark" : "text-slate-600 hover:bg-slate-50"}" do %>
        <%= report_icon(admin_nav_icon(key), css_class: "size-4") %>
        <%= label %>
      <% end %>
    <% end %>
  </nav>

  <div class="border-t border-slate-200 p-4">
    <div class="flex items-center gap-2.5">
      <div class="flex size-8 items-center justify-center rounded-full bg-teal-primary/10 text-xs font-semibold text-teal-dark">
        <%= current_admin_user.email.first.upcase %>
      </div>
      <div class="min-w-0 flex-1">
        <p class="truncate text-sm font-medium text-slate-900"><%= current_admin_user.email %></p>
        <p class="text-xs capitalize text-slate-500"><%= current_admin_user.role %></p>
      </div>
      <%= button_to logout_path, method: :delete, class: "text-slate-400 hover:text-slate-600", title: "Log out" do %>
        <%= report_icon(:logout, css_class: "size-4") %>
      <% end %>
    </div>
  </div>
</aside>
