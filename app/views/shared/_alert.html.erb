<%# Toast alert — locals: type (String: "error", "success"), message (String) %>
<% if message.present? %>
  <div data-controller="toast" class="pointer-events-auto flex w-full items-start gap-3 rounded-xl border bg-white p-4 opacity-0 translate-y-2 shadow-lg transition-all duration-300 ease-out <%= type == "error" ? "border-red-200" : "border-emerald-200" %>"
    role="alert" id="alert-<%= type %>">
    <%= icon_badge(type == "error" ? :alert_circle : :check,
          bg_class: type == "error" ? "bg-red-50" : "bg-emerald-50",
          text_class: type == "error" ? "text-red-600" : "text-emerald-600",
          size: "size-8") %>
    <p class="flex-1 pt-1 text-sm font-medium text-slate-900"><%= message %></p>
    <button type="button" data-action="toast#close" class="text-slate-400 hover:text-slate-600" aria-label="Dismiss">
      <%= report_icon(:x, css_class: "size-4") %>
    </button>
  </div>
<% end %>
