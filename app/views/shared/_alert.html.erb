<%# Shared alert component
     locals: type (String: "error", "success"), message (String) %>

<% if message.present? %>
  <% alert_classes = case type
     when "error"
       "bg-red-50 border-red-200 text-red-700"
     when "success"
       "bg-green-50 border-green-200 text-green-700"
     else
       "bg-blue-50 border-blue-200 text-blue-700"
     end %>

  <div class="flex items-center gap-2 px-4 py-3 text-sm font-medium rounded-lg border-[1.5px] <%= alert_classes %>" role="alert" id="alert-<%= type %>">
    <% if type == "error" %>
      <svg class="shrink-0 w-[18px] h-[18px] text-red-500" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.28 7.22a.75.75 0 00-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 101.06 1.06L10 11.06l1.72 1.72a.75.75 0 101.06-1.06L11.06 10l1.72-1.72a.75.75 0 00-1.06-1.06L10 8.94 8.28 7.22z" clip-rule="evenodd" />
      </svg>
    <% elsif type == "success" %>
      <svg class="shrink-0 w-[18px] h-[18px] text-green-500" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
      </svg>
    <% end %>
    <span><%= message %></span>
  </div>
<% end %>
