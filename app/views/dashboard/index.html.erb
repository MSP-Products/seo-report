<% content_for :title, "Dashboard — My Social Practice" %>

<div class="mb-6 flex items-start justify-between">
  <div>
    <h1 class="text-2xl font-semibold text-slate-900">Dashboard</h1>
    <p class="mt-1 text-sm text-slate-500"><%= @dashboard.report_month.strftime("%B %Y") %> reporting cycle</p>
  </div>

  <%= button_to "Run reports", report_generations_path, method: :post,
        class: "rounded-lg bg-teal-primary px-4 py-2 text-sm font-medium text-white hover:bg-teal-dark",
        form: { data: { turbo_confirm: "Queue report generation for every client without a completed report this month?" } } %>
</div>

<div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
  <%= render "reports/stat_card", icon: :users,
        value: @dashboard.client_rows.size,
        label: "Active clients",
        sublabel: "#{@dashboard.pending_onboarding_count} pending onboarding" %>

  <%= render "reports/stat_card", icon: :file_text,
        value: "#{@dashboard.generated_count}/#{@dashboard.client_rows.size}",
        label: "Reports generated",
        sublabel: @dashboard.failed_count > 0 ? "#{@dashboard.failed_count} failed — retry available" : "All caught up",
        badge: @dashboard.generated_count == @dashboard.client_rows.size ? "Complete" : "In progress",
        badge_class: @dashboard.generated_count == @dashboard.client_rows.size ? "bg-emerald-50 text-emerald-700" : "bg-cyan-100 text-cyan-700" %>

  <%= render "reports/stat_card", icon: :link,
        value: @dashboard.attention_count,
        label: "Connections needing attention",
        sublabel: "out of #{@dashboard.connections.size} integrations" %>

  <%= render "reports/stat_card", icon: :refresh,
        value: @dashboard.avg_duration_seconds ? "#{@dashboard.avg_duration_seconds / 60}m #{@dashboard.avg_duration_seconds % 60}s" : "—",
        label: "Average generation time",
        sublabel: @dashboard.avg_duration_seconds ? "Across all successful runs" : "Not enough data yet" %>
</div>

<div class="mt-6 overflow-x-auto rounded-2xl border border-slate-200 bg-white shadow-sm">
  <div class="border-b border-slate-200 px-5 py-4">
    <h2 class="font-medium text-slate-900"><%= @dashboard.report_month.strftime("%B %Y") %> generation status</h2>
  </div>
  <table class="w-full text-left text-sm">
    <thead class="text-xs uppercase text-slate-500">
      <tr>
        <th class="px-5 py-2">Client</th>
        <th class="px-5 py-2">Completed</th>
        <th class="px-5 py-2">Status</th>
        <th class="px-5 py-2"></th>
      </tr>
    </thead>
    <tbody class="divide-y divide-slate-100">
      <% @dashboard.client_rows.each do |row| %>
        <% label = { generated: "Generated", failed: "Failed", not_yet_generated: "Not yet generated" }.fetch(row.status) %>
        <tr>
          <td class="px-5 py-3">
            <p class="font-medium text-slate-900"><%= row.client.name %></p>
            <p class="text-xs text-slate-500"><%= row.client.city_state %></p>
          </td>
          <td class="px-5 py-3 text-slate-600"><%= row.latest_log&.attempted_at&.strftime("%b %-d, %Y") || "—" %></td>
          <td class="px-5 py-3">
            <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium <%= badge_class(label) %>"><%= label %></span>
          </td>
          <td class="px-5 py-3 text-right">
            <% if row.status == :failed %>
              <%= button_to "Retry", report_generations_path(client_id: row.client.id), method: :post,
                    class: "text-sm font-medium text-teal-dark hover:underline" %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<div class="mt-6 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
  <h2 class="font-medium text-slate-900">Data freshness</h2>
  <p class="mt-0.5 text-xs text-slate-500">Live status of each integration.</p>

  <div class="mt-4 space-y-3">
    <% @dashboard.connections.each do |connection| %>
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-2">
          <span class="size-2 rounded-full <%= connection.status_dot_class %>"></span>
          <span class="text-sm text-slate-700"><%= connection.display_name %></span>
        </div>
        <span class="text-sm text-slate-500"><%= connection.status_label %></span>
      </div>
    <% end %>
  </div>
</div>
