<%# locals: eyebrow, title, description (optional) — wraps a report section's heading block %>
<div class="mb-6">
  <p class="text-xs font-semibold uppercase tracking-wider text-teal-dark/70"><%= eyebrow %></p>
  <h2 class="mt-1 text-2xl font-semibold tracking-tight text-slate-900"><%= title %></h2>
  <% if local_assigns.fetch(:description, nil).present? %>
    <p class="mt-2 max-w-2xl text-sm text-slate-500"><%= description %></p>
  <% end %>
</div>
