<%# locals: report (ReportPresenter) %>
<div>
  <%= render "reports/section_card", eyebrow: "Overview", title: "Website Traffic & Conversions",
        description: "Visitor activity pulled from Google Analytics for the selected reporting period." %>

  <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
    <% if report.ga4_available? %>
      <%= render "shared/stat_card", icon: :users,
            value: report.traffic.total_visits,
            label: "Total Website Visits",
            sublabel: "#{report.traffic.unique_visitors} unique visitors · #{report.traffic.pages_per_visit} pages / visit" %>
    <% else %>
      <%= render "shared/stat_card", icon: :users,
            value: "—",
            label: "Total Website Visits",
            sublabel: "Google Analytics isn't connected yet for this practice" %>
    <% end %>

    <% if report.ghl_connected? %>
      <%= render "shared/stat_card", icon: :calendar_check,
            value: report.traffic.appointments_booked,
            label: "Appointments Booked",
            sublabel: "New appointments this period" %>
      <%= render "shared/stat_card", icon: :dollar, hero: true,
            value: number_to_currency(report.traffic.estimated_revenue, precision: 0),
            label: "Estimated revenue generated",
            sublabel: "Attributed to booked appointments",
            badge: "Revenue" %>
    <% else %>
      <%= render "shared/stat_card", icon: :calendar_check, value: "?", label: "Appointments Booked", sublabel: "New appointments this period" %>
      <%= render "shared/stat_card", icon: :dollar, value: "?", label: "Estimated revenue generated",
            sublabel: "Attributed to booked appointments", badge: "Revenue" %>
    <% end %>
  </div>

  <% unless report.ghl_connected? %>
    <p class="mt-4 rounded-xl border border-dashed border-slate-300 p-4 text-sm text-slate-600">
      Appointments booked and estimated revenue are showing as <strong>?</strong> because this practice
      isn't yet using our appointment scheduler and integration. Once connected, these values will
      populate automatically.
    </p>
  <% end %>

  <% if report.ga4_available? %>
    <div class="mt-6 rounded-2xl border border-slate-200 bg-white p-5">
      <div class="flex items-center justify-between">
        <p class="text-sm font-medium text-slate-900">Visits by Source</p>
        <p class="text-xs text-slate-500"><%= report.traffic.total_visits %> total visits</p>
      </div>

      <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        <% report.visits_by_source.each do |source| %>
          <div>
            <div class="flex items-baseline justify-between text-sm">
              <span class="text-slate-500"><%= source[:label] %></span>
              <span class="font-semibold text-slate-900"><%= source[:value] %></span>
            </div>
            <div class="mt-1.5 h-2 overflow-hidden rounded-full bg-slate-100">
              <div class="h-full rounded-full bg-teal-primary" style="width: <%= report.visit_share_pct(source[:value]) %>%"></div>
            </div>
            <p class="mt-1 text-xs text-slate-500"><%= report.visit_share_pct(source[:value]) %>% of total</p>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
