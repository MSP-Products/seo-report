<%# locals: report (ReportPresenter) — only rendered when report.ai_visibility_available? %>
<% ai = report.ai_visibility %>
<div>
  <%= render "reports/section_card", eyebrow: "Search Performance", title: "Google & AI Search Performance",
        description: "How your practice is ranking in traditional Google results and across AI-powered search tools." %>

  <div class="grid gap-4 sm:grid-cols-2">
    <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <p class="text-sm font-medium text-slate-900">Google Rank</p>
      <p class="mt-4 text-3xl font-semibold tracking-tight text-emerald-600"><%= ai.google_rank %></p>
      <p class="mt-1 text-xs text-slate-500">Top position in Google search results</p>
    </div>

    <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <p class="text-sm font-medium text-slate-900">AI Rank</p>
      <p class="mt-4 text-3xl font-semibold tracking-tight text-amber-600"><%= ai.ai_rank %></p>
      <p class="mt-1 text-xs text-slate-500">Average position across AI search tools</p>
    </div>

    <% sentiment = [
         ["Positive", ai.sentiment_positive_pct, "#10b981"],
         ["Neutral", ai.sentiment_neutral_pct, "#eab308"],
         ["Negative", ai.sentiment_negative_pct, "#ef4444"]
       ].select { |_, pct, _| pct.to_i.positive? } %>
    <% if sentiment.any? %>
      <% stops = []; cursor = 0
         sentiment.each do |label, pct, color|
           stops << "#{color} #{cursor}% #{cursor + pct}%"
           cursor += pct
         end %>
      <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
        <p class="text-sm font-medium text-slate-900">AI Brand Sentiment</p>
        <div class="mt-4 flex items-center gap-6">
          <div class="h-16 w-16 shrink-0 rounded-full" style="background: conic-gradient(<%= stops.join(", ") %>); mask: radial-gradient(farthest-side, transparent 62%, black 63%);"></div>
          <ul class="space-y-1">
            <% sentiment.each do |label, pct, color| %>
              <li class="flex items-center gap-2 text-sm">
                <span class="h-2 w-2 rounded-full" style="background-color: <%= color %>"></span>
                <span class="font-semibold text-slate-900"><%= pct %>%</span>
                <span class="text-slate-500"><%= label %></span>
              </li>
            <% end %>
          </ul>
        </div>
      </div>
    <% end %>

    <% citation_sources = [
         ["Your Websites", ai.citation_own_site_pct, "#6366f1"],
         ["Listings", ai.citation_listings_pct, "#06b6d4"],
         ["Reputation", ai.citation_reputation_pct, "#f59e0b"],
         ["Third-Party", ai.citation_third_party_pct, "#94a3b8"]
       ].select { |_, pct, _| pct.present? } %>
    <% if citation_sources.any? %>
      <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
        <p class="text-sm font-medium text-slate-900">AI Citations</p>
        <div class="mt-4 flex h-2 w-full overflow-hidden rounded-full">
          <% citation_sources.each do |label, pct, color| %>
            <div style="width: <%= pct %>%; background-color: <%= color %>"></div>
          <% end %>
        </div>
        <div class="mt-3 grid grid-cols-2 gap-x-4 gap-y-1.5">
          <% citation_sources.each do |label, pct, color| %>
            <div class="flex items-center gap-2 text-sm">
              <span class="h-2 w-2 shrink-0 rounded-full" style="background-color: <%= color %>"></span>
              <span class="font-semibold text-slate-900"><%= pct %>%</span>
              <span class="text-slate-500"><%= label %></span>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>
