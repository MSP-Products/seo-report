<%# locals: report (ReportPresenter) %>
<% if report.keyword_rows.any? %>
  <div>
    <% if report.first_report? %>
      <%= render "reports/section_card", eyebrow: "Search Rankings", title: "Keyword Baseline",
            description: "Starting positions for the keywords we're tracking. This is your month-one baseline — we'll measure movement against these numbers in future reports." %>

      <div class="mb-4 grid grid-cols-3 gap-3">
        <div class="rounded-xl border border-slate-200 bg-white px-4 py-3">
          <div class="text-xs text-slate-500">Keywords tracked</div>
          <div class="mt-1 text-xl font-semibold text-slate-900"><%= report.keywords_tracked_count %></div>
        </div>
        <div class="rounded-xl border border-slate-200 bg-white px-4 py-3">
          <div class="text-xs text-slate-500">Already ranking top 10</div>
          <div class="mt-1 text-xl font-semibold text-slate-900"><%= report.keywords_top10_count %></div>
        </div>
        <div class="rounded-xl border border-slate-200 bg-white px-4 py-3">
          <div class="text-xs text-slate-500">Already ranking top 3</div>
          <div class="mt-1 text-xl font-semibold text-slate-900"><%= report.keywords_top3_count %></div>
        </div>
      </div>
    <% else %>
      <%= render "reports/section_card", eyebrow: "Search Rankings", title: "Keyword Performance",
            description: "How your target keywords are performing in search results. These rankings directly impact how easily patients can find your practice." %>

      <div class="mb-4 grid grid-cols-3 gap-3">
        <div class="rounded-xl border border-slate-200 bg-white px-4 py-3">
          <div class="text-xs text-slate-500">Gained</div>
          <div class="mt-1 text-xl font-semibold text-emerald-600">↑ <%= report.keyword_gained_count %></div>
        </div>
        <div class="rounded-xl border border-slate-200 bg-white px-4 py-3">
          <div class="text-xs text-slate-500">Held</div>
          <div class="mt-1 text-xl font-semibold text-slate-900">= <%= report.keyword_held_count %></div>
        </div>
        <div class="rounded-xl border border-slate-200 bg-white px-4 py-3">
          <div class="text-xs text-slate-500">Dropped</div>
          <div class="mt-1 text-xl font-semibold text-red-600">↓ <%= report.keyword_dropped_count %></div>
        </div>
      </div>
    <% end %>

    <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white">
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead class="bg-slate-50 text-xs uppercase tracking-wider text-slate-500">
            <tr>
              <th class="px-4 py-3 text-left font-medium">Keyword</th>
              <th class="px-3 py-3 text-left font-medium">Intent</th>
              <th class="px-3 py-3 text-right font-medium">SF</th>
              <th class="px-3 py-3 text-right font-medium">KD %</th>
              <th class="px-3 py-3 text-right font-medium">Pot. Traffic</th>
              <th class="px-3 py-3 text-right font-medium">Growth</th>
              <% if report.first_report? %>
                <th class="px-4 py-3 text-right font-medium">Starting Position</th>
              <% else %>
                <th class="px-3 py-3 text-right font-medium">Prev</th>
                <th class="px-3 py-3 text-right font-medium">Current</th>
                <th class="px-4 py-3 text-right font-medium">Change</th>
              <% end %>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% report.keyword_rows.each do |row| %>
              <tr class="hover:bg-slate-50/75">
                <td class="px-4 py-3 font-medium text-slate-900"><%= row.keyword.keyword %></td>
                <td class="px-3 py-3">
                  <span class="inline-flex rounded-md px-2 py-0.5 text-xs font-medium <%= intent_badge_class(row.keyword.intent) %>">
                    <%= row.keyword.intent %>
                  </span>
                </td>
                <td class="px-3 py-3 text-right tabular-nums text-slate-500"><%= row.keyword.serp_features %></td>
                <td class="px-3 py-3 text-right font-medium tabular-nums <%= keyword_difficulty_class(row.keyword.keyword_difficulty) %>"><%= row.keyword.keyword_difficulty %></td>
                <td class="px-3 py-3 text-right tabular-nums text-slate-500"><%= number_with_precision(row.potential_traffic, precision: 2) %></td>
                <td class="px-3 py-3 text-right tabular-nums text-slate-500"><%= row.growth.to_f.positive? ? "+" : "" %><%= number_with_precision(row.growth, precision: 2) %></td>
                <% if report.first_report? %>
                  <td class="px-4 py-3 text-right font-medium tabular-nums text-slate-900"><%= row.position.present? ? "##{row.position}" : "—" %></td>
                <% else %>
                  <td class="px-3 py-3 text-right tabular-nums text-slate-500"><%= row.previous_position.present? ? "##{row.previous_position}" : "—" %></td>
                  <td class="px-3 py-3 text-right font-medium tabular-nums text-slate-900"><%= row.position.present? ? "##{row.position}" : "—" %></td>
                  <td class="px-4 py-3 text-right">
                    <% movement = report.keyword_movement(row) %>
                    <% if movement.nil? %>
                      <span class="text-slate-400">—</span>
                    <% elsif row.position.nil? %>
                      <span class="inline-flex items-center gap-1 rounded-full bg-red-50 px-2 py-0.5 text-xs font-medium text-red-600">Lost</span>
                    <% else %>
                      <% change = report.keyword_change(row) %>
                      <% if change.zero? %>
                        <span class="inline-flex items-center gap-1 rounded-full bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-500">0</span>
                      <% elsif change.positive? %>
                        <span class="inline-flex items-center gap-1 rounded-full bg-emerald-50 px-2 py-0.5 text-xs font-medium text-emerald-600"><%= report_icon(:arrow_up_right, css_class: "size-3") %>↑<%= change %></span>
                      <% else %>
                        <span class="inline-flex items-center gap-1 rounded-full bg-red-50 px-2 py-0.5 text-xs font-medium text-red-600"><%= report_icon(:trending_down, css_class: "size-3") %>↓<%= change.abs %></span>
                      <% end %>
                    <% end %>
                  </td>
                <% end %>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
    <p class="mt-2 text-xs text-slate-500">SF: SERP Features · KD: Keyword Difficulty · Intent — C: Commercial, T: Transactional, I: Informational</p>
  </div>
<% end %>
