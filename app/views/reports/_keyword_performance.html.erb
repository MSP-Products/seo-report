<%# locals: report (ReportPresenter) %>
<% if report.keyword_rows.any? %>
  <div>
    <% if report.first_report? %>
      <%= render "reports/section_card", eyebrow: "Search Rankings", title: "Keyword Baseline",
            description: "Starting positions for the keywords we're tracking. This is your month-one baseline — we'll measure movement against these numbers in future reports." %>

      <div class="mb-4 grid grid-cols-3 gap-3">
        <div class="rounded-xl border border-slate-200 bg-white px-4 py-3">
          <div class="text-xs text-slate-500">Keywords tracked</div>
          <div class="mt-1 text-xl font-semibold text-slate-900"><%= report.keywords_tracked_count %></div>
        </div>
        <div class="rounded-xl border border-slate-200 bg-white px-4 py-3">
          <div class="text-xs text-slate-500">Already ranking top 10</div>
          <div class="mt-1 text-xl font-semibold text-slate-900"><%= report.keywords_top10_count %></div>
        </div>
        <div class="rounded-xl border border-slate-200 bg-white px-4 py-3">
          <div class="text-xs text-slate-500">Already ranking top 3</div>
          <div class="mt-1 text-xl font-semibold text-slate-900"><%= report.keywords_top3_count %></div>
        </div>
      </div>
    <% else %>
      <%= render "reports/section_card", eyebrow: "Search Rankings", title: "Keyword Performance",
            description: "How your target keywords are performing in search results. These rankings directly impact how easily patients can find your practice." %>

      <div class="mb-4 grid grid-cols-3 gap-3">
        <div class="rounded-xl border border-slate-200 bg-white px-4 py-3">
          <div class="text-xs text-slate-500">Gained</div>
          <div class="mt-1 text-xl font-semibold text-emerald-600">↑ <%= report.keyword_gained_count %></div>
        </div>
        <div class="rounded-xl border border-slate-200 bg-white px-4 py-3">
          <div class="text-xs text-slate-500">Held</div>
          <div class="mt-1 text-xl font-semibold text-slate-900">= <%= report.keyword_held_count %></div>
        </div>
        <div class="rounded-xl border border-slate-200 bg-white px-4 py-3">
          <div class="text-xs text-slate-500">Dropped</div>
          <div class="mt-1 text-xl font-semibold text-red-600">↓ <%= report.keyword_dropped_count %></div>
        </div>
      </div>
    <% end %>

    <%= turbo_frame_tag "keyword_table" do %>
      <%= render "reports/keyword_table", report: report, rows: report.paginated_keyword_rows %>

      <% if report.keyword_total_pages > 1 %>
        <div class="mt-3 flex items-center justify-between text-sm text-slate-500">
          <% if report.keyword_page > 1 %>
            <%= link_to "← Previous", public_report_path(report.access_token, keyword_page: report.keyword_page - 1),
                  class: "font-medium text-teal-dark hover:underline" %>
          <% else %>
            <span></span>
          <% end %>

          <span>Page <%= report.keyword_page %> of <%= report.keyword_total_pages %> (<%= report.keywords_tracked_count %> keywords)</span>

          <% if report.keyword_page < report.keyword_total_pages %>
            <%= link_to "Next →", public_report_path(report.access_token, keyword_page: report.keyword_page + 1),
                  class: "font-medium text-teal-dark hover:underline" %>
          <% else %>
            <span></span>
          <% end %>
        </div>
      <% end %>
    <% end %>

    <p class="mt-2 text-xs text-slate-500">SF: SERP Features · KD: Keyword Difficulty · Intent — C: Commercial, T: Transactional, I: Informational, N: Navigational</p>
  </div>
<% end %>
