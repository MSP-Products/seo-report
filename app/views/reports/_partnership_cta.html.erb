<%# Static templated block, shown only on first reports. No locals. %>
<div class="rounded-2xl border border-slate-200 bg-white p-6 sm:p-8">
  <%= render "reports/section_card", eyebrow: "Partnership", title: "How You Can Support Your SEO",
        description: "Small actions from your practice each month make a meaningful difference in your local search visibility." %>

  <div class="mt-6 grid sm:grid-cols-2 gap-4">
    <% [
      [:star, "Ask for reviews", "Invite happy patients to leave a Google review after appointments. A steady flow of fresh reviews is one of the strongest local ranking signals."],
      [:chat, "Reply to every review", "Respond to reviews — positive and negative. Thoughtful replies build patient trust and show Google your profile is active and cared for."],
      [:camera, "Share practice photos", "Send us photos of your team, office, and recent events. Fresh, authentic images keep your profile engaging and help convert searchers into patients."],
      [:refresh, "Keep info updated", "Let us know about new services, hours, team members, or promotions so we can keep your website and Google profile accurate and competitive."]
    ].each do |icon, title, body| %>
      <div class="rounded-xl border border-slate-200 p-5">
        <%= icon_badge(icon, bg_class: "bg-teal-primary/10", text_class: "text-teal-dark") %>
        <p class="mt-3 font-semibold text-slate-900"><%= title %></p>
        <p class="mt-1.5 text-sm text-slate-600 leading-relaxed"><%= body %></p>
      </div>
    <% end %>
  </div>
</div>
