<%# locals: report (ReportPresenter) %>
<% citation = report.citation %>
<% if citation.present? %>
  <div>
    <%= render "reports/section_card", eyebrow: "Local Presence", title: "Citation & Directory Performance",
          description: "How your practice information performs across online directories — visibility and engagement over 30 days." %>

    <% show_breakdown = citation.driving_directions_count.present? || citation.website_clicks_count.present? %>
    <div class="grid gap-4 <%= show_breakdown ? "lg:grid-cols-3" : "sm:grid-cols-2" %>">
      <%= render "shared/stat_card", icon: :eye, icon_bg: "bg-cyan-100", icon_text: "text-cyan-700",
            value: citation.total_impressions,
            label: "Total Listing Impressions",
            sublabel: report.first_report? ? "Baseline — how people are finding you" : "How people are finding you",
            badge: (report.citation_impressions_change_pct.present? ? "#{report.citation_impressions_change_pct}%" : nil),
            badge_class: "bg-red-50 text-red-600", badge_icon: :trending_down %>
      <%= render "shared/stat_card", icon: :cursor_click, icon_bg: "bg-violet-100", icon_text: "text-violet-700",
            value: citation.total_engagements,
            label: "Total Engagements",
            sublabel: report.first_report? ? "Baseline — how many people engage" : "How many people engage",
            badge: (report.citation_engagements_change_pct.present? ? "#{report.citation_engagements_change_pct}%" : nil),
            badge_class: "bg-red-50 text-red-600", badge_icon: :trending_down %>

      <% if show_breakdown %>
        <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
          <p class="text-sm font-medium text-slate-900">Engagement Breakdown</p>

          <div class="mt-4 space-y-3">
            <% if citation.driving_directions_count.present? %>
              <div>
                <div class="flex items-baseline justify-between text-sm">
                  <span class="text-slate-500">Driving Directions</span>
                  <span class="font-semibold text-slate-900"><%= citation.driving_directions_count %></span>
                </div>
                <div class="mt-1.5 h-2 overflow-hidden rounded-full bg-slate-100">
                  <div class="h-full rounded-full bg-teal-primary" style="width: <%= report.engagement_share_pct(citation.driving_directions_count) %>%"></div>
                </div>
                <p class="mt-1 text-xs text-slate-500"><%= report.engagement_share_pct(citation.driving_directions_count) %>% of engagements</p>
              </div>
            <% end %>

            <% if citation.website_clicks_count.present? %>
              <div>
                <div class="flex items-baseline justify-between text-sm">
                  <span class="text-slate-500">Website Clicks</span>
                  <span class="font-semibold text-slate-900"><%= citation.website_clicks_count %></span>
                </div>
                <div class="mt-1.5 h-2 overflow-hidden rounded-full bg-slate-100">
                  <div class="h-full rounded-full bg-cyan-primary" style="width: <%= report.engagement_share_pct(citation.website_clicks_count) %>%"></div>
                </div>
                <p class="mt-1 text-xs text-slate-500"><%= report.engagement_share_pct(citation.website_clicks_count) %>% of engagements</p>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
