<%# locals: report (ReportPresenter) %>
<% summary = report.gbp_summary %>
<% if summary.present? %>
  <div>
    <%= render "reports/section_card", eyebrow: "This Month's Work", title: "Google Business Profile Activity",
          description: "Posts published, photos added, and new reviews received on the practice's Google Business Profile this month." %>

    <div class="grid gap-4 md:grid-cols-2">
      <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
        <div class="flex items-center justify-between">
          <%= icon_badge(:star, bg_class: "bg-teal-primary/10", text_class: "text-teal-dark") %>
          <span class="text-xs font-medium text-slate-500"><%= summary.total_reviews %> total</span>
        </div>
        <div class="mt-4 flex items-baseline gap-2">
          <span class="text-3xl font-semibold tracking-tight text-slate-900"><%= number_with_precision(summary.average_rating, precision: 1) %></span>
          <span class="flex items-center gap-0.5">
            <% rounded = summary.average_rating.to_f.round %>
            <% rounded.times do %><span class="text-amber-500"><%= report_icon(:star, css_class: "size-3.5 fill-current") %></span><% end %>
            <% (5 - rounded).times do %><span class="text-slate-300"><%= report_icon(:star, css_class: "size-3.5") %></span><% end %>
          </span>
        </div>
        <div class="mt-1 text-sm font-medium text-slate-900">Google Reviews</div>
        <% if summary.new_positive_reviews.to_i.positive? || summary.new_negative_reviews.to_i.positive? %>
          <div class="mt-2 flex items-center gap-3 text-xs">
            <% if summary.new_positive_reviews.to_i.positive? %>
              <span class="inline-flex items-center gap-1 rounded-full bg-emerald-50 px-2 py-0.5 font-medium text-emerald-700">
                <%= report_icon(:trending_up, css_class: "size-3") %>+<%= summary.new_positive_reviews %> positive
              </span>
            <% end %>
            <% if summary.new_negative_reviews.to_i.positive? %>
              <span class="inline-flex items-center gap-1 rounded-full bg-red-50 px-2 py-0.5 font-medium text-red-600">
                <%= report_icon(:trending_down, css_class: "size-3") %><%= summary.new_negative_reviews %> negative
              </span>
            <% end %>
          </div>
          <div class="mt-1.5 text-xs text-slate-500">New reviews this month</div>
        <% end %>
      </div>

      <% if report.gbp_posts.any? %>
        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
          <div class="flex items-center gap-2 text-teal-dark">
            <%= report_icon(:file_text) %>
            <span class="text-xs font-semibold uppercase tracking-wider">Posts Published</span>
          </div>
          <ul class="mt-4 space-y-4">
            <% report.gbp_posts.each do |post| %>
              <li class="border-b border-slate-200 pb-3 last:border-0 last:pb-0">
                <div class="flex items-baseline justify-between gap-2">
                  <div class="text-sm font-semibold text-slate-900"><%= post.title %></div>
                  <div class="shrink-0 text-xs text-slate-500"><%= post.published_at&.strftime("%b %-d, %Y") %></div>
                </div>
                <p class="mt-1 text-sm leading-relaxed text-slate-500"><%= post.description %></p>
              </li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <% if report.gbp_reviews.any? %>
        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
          <div class="flex items-center gap-2 text-teal-dark">
            <%= report_icon(:star) %>
            <span class="text-xs font-semibold uppercase tracking-wider">New Reviews</span>
          </div>
          <ul class="mt-4 space-y-4">
            <% report.gbp_reviews.each do |review| %>
              <li class="<%= review.needs_action? ? "-mx-3 rounded-lg border border-red-200 bg-red-50/60 p-3" : "border-b border-slate-200 pb-3" %> last:border-0 last:pb-0">
                <div class="flex items-baseline justify-between gap-2">
                  <div class="text-sm font-semibold text-slate-900"><%= review.author_name %></div>
                  <div class="shrink-0 text-xs text-slate-500"><%= review.posted_at&.strftime("%b %-d, %Y") %></div>
                </div>
                <div class="mt-1 flex items-center gap-0.5">
                  <% rating = review.rating.to_i %>
                  <% rating.times do %><span class="<%= review.needs_action? ? "text-red-600" : "text-amber-500" %>"><%= report_icon(:star, css_class: "size-3 fill-current") %></span><% end %>
                  <% (5 - rating).times do %><span class="text-slate-300"><%= report_icon(:star, css_class: "size-3") %></span><% end %>
                </div>
                <p class="mt-1.5 text-sm leading-relaxed <%= review.needs_action? ? "text-red-700" : "text-slate-500" %>">&ldquo;<%= review.body %>&rdquo;</p>
                <% if review.needs_action? %>
                  <div class="mt-3 rounded-md border border-red-200 bg-red-100 px-3 py-2 text-xs text-red-700">
                    <strong>Action needed:</strong> Reach out to this patient directly to understand their concern and resolve it offline.
                  </div>
                <% end %>
              </li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
        <div class="flex items-center gap-2 text-teal-dark">
          <%= report_icon(:image) %>
          <span class="text-xs font-semibold uppercase tracking-wider">Photos Added</span>
        </div>
        <% if report.gbp_photos.any? %>
          <div class="mt-4 grid grid-cols-3 gap-3">
            <% report.gbp_photos.each do |photo| %>
              <img src="<%= photo.image_url %>" alt="<%= photo.caption %>" class="aspect-square w-full rounded-lg object-cover">
            <% end %>
          </div>
        <% elsif report.needs_photos? %>
          <div class="relative mt-4 rounded-lg border border-amber-300/50 bg-amber-50 px-4 py-3 pl-10 text-sm text-amber-900">
            <span class="absolute left-4 top-3.5 text-amber-500"><%= report_icon(:info, css_class: "size-4") %></span>
            We didn't add any photos this month because we need some from you. Please share a few
            recent images of your office, team, or work so we can keep your profile fresh.
          </div>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
