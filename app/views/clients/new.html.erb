<% content_for :title, "Add client — My Social Practice" %>

<div class="mb-6">
  <%= link_to "← Clients", clients_path, class: "text-sm text-slate-500 hover:text-slate-700" %>
  <h1 class="mt-2 text-2xl font-semibold tracking-tight text-slate-900">Add client</h1>
  <p class="mt-1 text-sm text-slate-500">
    Enroll a new practice in monthly SEO reporting.
    <% if @client.hubspot_link&.external_id.blank? %>
      <%= link_to "Search HubSpot instead", hubspot_search_clients_path, class: "font-medium text-teal-dark hover:underline" %>
      to fill this in automatically.
    <% end %>
  </p>
</div>

<div class="max-w-2xl">
  <%= render "form", client: @client %>
</div>
