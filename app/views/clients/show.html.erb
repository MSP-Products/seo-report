<% content_for :title, "#{@client.name} — My Social Practice" %>

<p class="mb-2 text-sm text-slate-500"><%= link_to "← Clients", clients_path, class: "hover:underline" %></p>

<%= render "clients/header", client: @client, active_tab: :overview %>

<div class="space-y-6">
  <%= render "clients/report_history", reports: @reports %>

  <% if @latest_report_presenter %>
    <div>
      <h2 class="mb-1 font-medium text-slate-900">Latest report snapshot</h2>
      <p class="mb-3 text-xs text-slate-500">
        <%= @latest_report.report_month.strftime("%B %Y") %> — the same numbers the client sees.
      </p>
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <%= render "reports/stat_card", icon: :trending_up,
              value: @latest_report_presenter.traffic&.total_visits || "—", label: "Website visits" %>
        <%= render "reports/stat_card", icon: :calendar_check,
              value: @latest_report_presenter.traffic&.appointments_booked || "—", label: "Appointments" %>
        <%= render "reports/stat_card", icon: :star,
              value: @latest_report_presenter.keywords_top10_count, label: "Keywords in top 10" %>
        <%= render "reports/stat_card", icon: :sparkles,
              value: @latest_report_presenter.ai_visibility&.overall_score || "—", label: "AI visibility score" %>
      </div>
    </div>
  <% end %>

  <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
    <div class="flex items-center justify-between">
      <h2 class="font-medium text-slate-900">Current month — <%= MonthlyReport.reporting_month.strftime("%B %Y") %></h2>
      <% if @current_cycle_report %>
        <% status = @current_cycle_report.generation_status
           label = { generated: "Generated", failed: "Failed", not_yet_generated: "Not yet generated" }.fetch(status) %>
        <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium <%= badge_class(label) %>"><%= label %></span>
      <% end %>
    </div>

    <% if @current_cycle_report %>
      <div class="mt-4 space-y-2 text-sm">
        <div class="flex items-center gap-2">
          <%= report_icon(@current_cycle_report.report_highlight.present? ? :check : :info, css_class: "size-4 text-slate-400") %>
          <span class="text-slate-700">Highlights written</span>
        </div>
        <div class="flex items-center gap-2">
          <%= report_icon(@current_cycle_report.generated_at.present? ? :check : :info, css_class: "size-4 text-slate-400") %>
          <span class="text-slate-700">Report rendered</span>
        </div>
      </div>
    <% else %>
      <p class="mt-3 text-sm text-slate-500">Not generated yet.</p>
    <% end %>

    <%= button_to (@current_cycle_report ? "Regenerate" : "Generate report"),
          report_generations_path(client_id: @client.id), method: :post,
          class: "mt-4 rounded-lg bg-teal-primary px-4 py-2 text-sm font-medium text-white hover:bg-teal-dark" %>
  </div>

  <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
    <h2 class="font-medium text-slate-900">Secure report link</h2>
    <% if @latest_report %>
      <div class="mt-3 flex items-center gap-2" data-controller="clipboard">
        <input type="text" readonly value="<%= public_report_path(@latest_report.access_token) %>" data-clipboard-target="source"
               class="w-full max-w-md truncate rounded-lg border border-slate-300 bg-slate-50 px-3 py-2 text-sm text-slate-600">
        <button type="button" data-action="clipboard#copy" data-clipboard-target="button"
                class="rounded-lg border border-slate-300 px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50">
          Copy
        </button>
      </div>
      <p class="mt-2 text-xs text-slate-500">The unguessable link for <%= @latest_report.report_month.strftime("%B %Y") %>'s report.</p>
    <% else %>
      <p class="mt-3 text-sm text-slate-500">No report generated yet.</p>
    <% end %>
  </div>
</div>
