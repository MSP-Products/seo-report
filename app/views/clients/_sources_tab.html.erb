<%# locals: client (Client) %>
<div class="rounded-2xl border border-slate-200 bg-white shadow-sm">
  <div class="flex items-start justify-between gap-4 border-b border-slate-200 p-5">
    <div>
      <h2 class="text-sm font-medium text-slate-900">Data sources for this practice</h2>
      <p class="mt-1 text-xs text-slate-500">Inherits the agency connection unless an override is set.</p>
    </div>
    <% if current_admin_user.admin? %>
      <%= link_to "Edit", edit_client_path(client), class: "shrink-0 text-sm font-medium text-teal-dark hover:underline" %>
    <% end %>
  </div>

  <div class="divide-y divide-slate-100">
    <% Service::KEYS.each do |service| %>
      <% link = client.client_service_links.find_or_initialize_by(service: service) %>
      <% display = AgencyConnection::DISPLAY.fetch(service) %>
      <div class="flex flex-wrap items-center gap-4 px-5 py-3.5">
        <div class="flex size-8 shrink-0 items-center justify-center rounded-lg <%= display[:badge_class] %> text-xs font-bold text-white">
          <%= display[:letter] %>
        </div>
        <span class="w-36 shrink-0 text-sm font-medium text-slate-900"><%= display[:name] %></span>
        <code class="min-w-0 flex-1 truncate text-xs text-slate-500"><%= link.external_id.presence || "—" %></code>
        <span class="flex shrink-0 items-center gap-1.5 text-xs font-medium text-slate-600">
          <span class="size-2 rounded-full <%= client_source_status_dot_class(link) %>"></span>
          <%= client_source_status_label(link) %>
        </span>
      </div>
    <% end %>
  </div>
</div>
