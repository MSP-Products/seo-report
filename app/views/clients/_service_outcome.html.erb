<%# locals: service (String), outcome (Match | false | :error | :pending | nil), duration_ms (Integer) %>
<div id="service_outcome_<%= service %>">
  <% if outcome == :pending %>
    <div class="mt-2 ml-12 flex items-center gap-2" data-controller="service-timer" data-service-timer-duration-value="<%= duration_ms || 8000 %>">
      <svg class="size-4 animate-spin text-slate-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
      </svg>
      <span class="text-xs text-slate-500">
        Searching…
        <span data-service-timer-target="countdown" class="font-medium text-slate-600"></span>
      </span>
    </div>
  <% elsif outcome.is_a?(Data) %>
    <div class="mt-2 ml-12 flex flex-wrap items-center justify-between gap-3 rounded-lg border border-teal-primary/20 bg-teal-50/60 px-3 py-2">
      <div class="min-w-0 text-xs text-slate-600">
        <p class="truncate font-medium text-slate-900"><%= outcome.name %></p>
        <p class="truncate text-slate-500"><%= service_match_detail(service, outcome) %> · <code><%= service_match_id(service, outcome) %></code></p>
      </div>
      <div class="shrink-0 flex gap-2">
        <button type="button" data-controller="apply-suggestion"
                data-apply-suggestion-external-id-value="<%= service_match_id(service, outcome) %>"
                data-action="apply-suggestion#apply"
                class="cursor-pointer rounded-lg bg-teal-primary px-3 py-1.5 text-xs font-medium text-white hover:bg-teal-dark">
          Use this match
        </button>
        <button type="button" data-controller="dismiss-suggestion"
                data-action="dismiss-suggestion#dismiss"
                class="cursor-pointer rounded-lg border border-slate-200 px-2 py-1.5 text-xs font-medium text-slate-600 hover:bg-slate-50">
          ×
        </button>
      </div>
    </div>
    <p class="mt-1 pl-12 text-xs text-slate-400">Click Save practice below to confirm.</p>
  <% elsif outcome == false %>
    <p class="mt-2 pl-12 text-xs text-slate-500">No match found matching this practice's website.</p>
  <% elsif outcome == :error %>
    <p class="mt-2 pl-12 text-xs text-red-600">Couldn't reach this service — try again in a moment.</p>
  <% end %>
</div>
