<%# locals: client (Client) %>
<% current_report = client.monthly_reports.order(report_month: :desc).first %>
<% latest_ready_report = client.monthly_reports.generated.order(report_month: :desc).first %>
<% hubspot_link = client.hubspot_link %>

<div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
  <div class="flex items-center justify-between">
    <h2 class="text-sm font-medium text-slate-900">HubSpot sync</h2>
    <% if current_admin_user.admin? %>
      <%= link_to "Manage", edit_client_path(client), class: "text-xs font-medium text-teal-dark hover:underline" %>
    <% end %>
  </div>
  <div class="mt-2 flex items-center gap-1.5 text-sm text-slate-700">
    <span class="size-2 rounded-full <%= hubspot_sync_status_dot_class(hubspot_link) %>"></span>
    <%= hubspot_sync_status_label(hubspot_link) %>
  </div>
  <% if hubspot_link&.last_sync_error.present? %>
    <p class="mt-1 text-xs text-red-600"><%= hubspot_sync_error_message(hubspot_link) %></p>
  <% end %>
</div>

<% if latest_ready_report %>
  <% presenter = ReportPresenter.new(latest_ready_report) %>
  <div class="mt-4 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
    <h2 class="text-sm font-medium text-slate-900">Latest report snapshot</h2>
    <p class="mt-1 text-xs text-slate-500">
      <%= latest_ready_report.report_month.strftime("%B %Y") %> — the same numbers the client sees.
    </p>
    <div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-4">
      <%= render "shared/stat_card", icon: :trending_up,
            value: latest_ready_report.report_traffic&.total_visits || "—", label: "Website visits" %>
      <%= render "shared/stat_card", icon: :calendar_check,
            value: latest_ready_report.report_traffic&.appointments_booked || "—", label: "Appointments" %>
      <%= render "shared/stat_card", icon: :search,
            value: presenter.keywords_top10_count, label: "Keywords in top 10" %>
      <%= render "shared/stat_card", icon: :sparkles,
            value: latest_ready_report.report_ai_visibility&.overall_score || "—", label: "AI visibility score" %>
    </div>
  </div>
<% end %>

<% if current_report %>
  <% failed_attempts = current_report.failed? ? current_report.attempt_count : [ current_report.attempt_count - 1, 0 ].max %>
  <div class="mt-4 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
    <div class="flex items-center justify-between">
      <h2 class="text-sm font-medium text-slate-900">Current month — <%= current_report.report_month.strftime("%B %Y") %></h2>
      <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium <%= generation_status_badge_class(current_report) %>">
        <%= generation_status_label(current_report) %>
      </span>
    </div>
    <dl class="mt-4 space-y-3 text-sm">
      <div class="flex items-center justify-between gap-4">
        <dt class="text-slate-500">Report generated</dt>
        <dd class="text-slate-900"><%= current_report.generated_at? ? current_report.generated_at.strftime("%b %-d, %-I:%M %p") : "Not yet" %></dd>
      </div>
      <div class="flex items-center justify-between gap-4">
        <dt class="text-slate-500">Email sent</dt>
        <dd class="text-slate-900"><%= current_report.emailed_at? ? current_report.emailed_at.strftime("%b %-d, %-I:%M %p") : "Not sent" %></dd>
      </div>
      <div class="flex items-center justify-between gap-4">
        <dt class="text-slate-500">Failed attempts</dt>
        <dd class="<%= failed_attempts.positive? ? "font-medium text-red-600" : "text-slate-900" %>"><%= failed_attempts %></dd>
      </div>
    </dl>
  </div>
<% end %>

<div class="mt-4 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
  <h2 class="text-sm font-medium text-slate-900">Secure report link</h2>
  <% if current_report %>
    <div class="mt-3 flex flex-col gap-2 sm:flex-row sm:items-center" data-controller="copy">
      <div class="flex-1 break-all rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 text-sm text-slate-700" data-copy-target="source">
        <%= public_report_url(current_report.access_token) %>
      </div>
      <button type="button" data-action="copy#copy" data-copy-target="label"
        class="shrink-0 rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50">
        Copy
      </button>
    </div>
    <p class="mt-2 text-xs text-slate-500">
      Unguessable token, one per client per month. Regenerating that month's report issues a new one.
    </p>
  <% else %>
    <p class="mt-2 text-sm text-slate-500">No report generated yet — nothing to link to.</p>
  <% end %>
</div>
