<%# locals: client (Client), active_tab (Symbol: :overview / :reports / :keywords / :data_sources) %>
<div class="mb-6 overflow-hidden rounded-2xl bg-gradient-to-br from-teal-primary to-cyan-primary text-white shadow-sm">
  <div class="flex items-start justify-between gap-4 p-6">
    <div>
      <span class="inline-flex items-center rounded-full bg-white/15 px-2 py-0.5 text-xs font-medium">
        <%= client.status_badge_text %>
      </span>
      <h1 class="mt-2 text-2xl font-semibold"><%= client.name %></h1>
      <div class="mt-1 flex flex-wrap gap-4 text-sm text-white/80">
        <% if client.address.present? %><span><%= client.address %></span><% end %>
        <% if client.website_url.present? %><span><%= client.website_url %></span><% end %>
        <% if client.phone.present? %><span><%= client.phone %></span><% end %>
      </div>
    </div>
    <div class="flex shrink-0 items-center gap-2">
      <%= button_to "Generate report", report_generations_path(client_id: client.id), method: :post,
            class: "rounded-lg bg-white px-4 py-2 text-sm font-medium text-teal-dark hover:bg-white/90" %>
      <span class="cursor-not-allowed rounded-lg bg-white/15 px-4 py-2 text-sm font-medium text-white/70" title="Not built yet">
        Edit practice
      </span>
    </div>
  </div>
</div>

<nav class="mb-6 flex gap-6 border-b border-slate-200 text-sm">
  <% [
    [ :overview, "Overview", client_path(client) ],
    [ :reports, "Reports", client_reports_path(client) ],
    [ :keywords, "Keywords", client_keywords_path(client) ],
    [ :data_sources, "Data sources", client_data_sources_path(client) ]
  ].each do |key, label, path| %>
    <% is_active = key == active_tab %>
    <%= link_to label, path,
          class: "-mb-px border-b-2 pb-3 #{is_active ? "border-teal-primary font-medium text-teal-dark" : "border-transparent text-slate-500 hover:text-slate-700"}" %>
  <% end %>
</nav>
