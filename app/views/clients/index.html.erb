<% content_for :title, "Clients — My Social Practice" %>

<style>
  .offboard-btn {
    background-color: #FEE2E2;
    color: #B91C1C;
    transition-property: background-color;
    transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
    transition-duration: 150ms;
  }
  .offboard-btn:hover {
    background-color: #FECACA;
  }
</style>

<div class="mb-6 flex flex-wrap items-start justify-between gap-4">
  <div>
    <h1 class="text-2xl font-semibold tracking-tight text-slate-900">Clients</h1>
    <p class="mt-1 text-sm text-slate-500">Every practice enrolled in monthly SEO reporting.</p>
  </div>
  <% if current_admin_user.admin? %>
    <div class="relative" data-controller="dropdown">
      <button type="button" data-action="dropdown#toggle"
            class="flex items-center gap-1.5 rounded-lg bg-teal-primary px-4 py-2 text-sm font-medium text-white hover:bg-teal-dark">
        <%= report_icon(:plus, css_class: "size-4") %> Add client
        <%= report_icon(:chevron_down, css_class: "size-4") %>
      </button>
      <div data-dropdown-target="menu" class="absolute right-0 mt-1 hidden w-48 rounded-lg border border-slate-200 bg-white shadow-lg">
        <%= link_to hubspot_search_clients_path,
              class: "block px-4 py-2.5 text-sm text-slate-700 hover:bg-slate-50 first:rounded-t-lg" do %>
          Import from HubSpot
        <% end %>
        <%= link_to new_client_path,
              class: "block px-4 py-2.5 text-sm text-slate-700 hover:bg-slate-50 last:rounded-b-lg border-t border-slate-100" do %>
          Add manually
        <% end %>
      </div>
    </div>
  <% end %>
</div>

<!-- Tabs -->
<nav class="mb-6 flex gap-1 border-b border-slate-200 overflow-x-auto">
  <%= link_to "All #{@status_counts["all"]}", clients_path(q: params[:q], status: "all"),
        class: "shrink-0 whitespace-nowrap border-b-2 px-4 py-2 text-sm font-medium #{@status == "all" ? "border-teal-primary text-teal-dark" : "border-transparent text-slate-500 hover:text-slate-700"}" %>
  <% Client.onboarding_statuses.each_key do |status| %>
    <%= link_to "#{status.capitalize} #{@status_counts[status]}", clients_path(q: params[:q], status: status),
          class: "shrink-0 whitespace-nowrap border-b-2 px-4 py-2 text-sm font-medium #{@status == status ? "border-teal-primary text-teal-dark" : "border-transparent text-slate-500 hover:text-slate-700"}" %>
  <% end %>
</nav>

<!-- Search -->
<%= form_with url: clients_path, method: :get, class: "mb-4" do %>
  <div class="relative w-full max-w-xs">
    <span class="pointer-events-none absolute inset-y-0 left-3 flex items-center text-slate-400">
      <%= report_icon(:search, css_class: "size-4") %>
    </span>
    <input type="search" name="q" value="<%= params[:q] %>" placeholder="Search practices"
      class="w-full rounded-lg border border-slate-200 py-2 pl-9 pr-3 text-sm focus:ring-3 focus:ring-teal-600/15">
    <input type="hidden" name="status" value="<%= @status %>">
  </div>
<% end %>

<% if @query.records.any? %>
  <div class="rounded-2xl border border-slate-200 bg-white shadow-sm">
    <div class="overflow-x-auto">
      <div class="grid min-w-[1040px] grid-cols-[2fr_0.7fr_1.1fr_1.3fr_1fr_0.9fr_40px] gap-4 border-b border-slate-200 bg-slate-50 px-5 py-2.5 text-xs font-semibold uppercase tracking-wider text-slate-500">
        <span>Practice</span>
        <span>Status</span>
        <span>Enrollments</span>
        <span>Data sources</span>
        <span>Latest report</span>
        <span>Delivery</span>
        <span></span>
      </div>
      <div class="min-w-[1040px] divide-y divide-slate-100">
        <% @query.records.each do |client| %>
          <% row = ClientRowPresenter.new(client) %>
          <div class="relative grid grid-cols-[2fr_0.7fr_1.1fr_1.3fr_1fr_0.9fr_40px] items-center gap-4 px-5 py-3.5 hover:bg-slate-50/75" data-controller="dropdown">
            <%= link_to client_path(client), class: "contents" do %>
              <div class="flex min-w-0 items-center gap-3">
                <div class="flex size-9 shrink-0 items-center justify-center rounded-lg bg-teal-primary/10 text-xs font-bold text-teal-dark">
                  <%= row.initials %>
                </div>
                <div class="min-w-0">
                  <p class="truncate text-sm font-medium text-slate-900"><%= row.name %></p>
                  <p class="truncate text-xs text-slate-500"><%= row.website_url %></p>
                </div>
              </div>
              <span class="inline-flex w-fit items-center self-center rounded-full px-2 py-0.5 text-xs font-medium <%= client_status_badge_class(client) %>">
                <%= row.onboarding_status.capitalize %>
              </span>
              <div class="flex flex-wrap items-center gap-1.5">
                <span class="rounded-md px-2 py-0.5 text-xs font-medium <%= row.ai_seo_enrolled? ? "bg-teal-primary/10 text-teal-dark" : "bg-slate-100 text-slate-400" %>">AI SEO</span>
                <span class="rounded-md px-2 py-0.5 text-xs font-medium <%= row.scheduler_enabled? ? "bg-teal-primary/10 text-teal-dark" : "bg-slate-100 text-slate-400" %>">Scheduler</span>
              </div>
              <div class="flex items-center gap-2">
                <% row.service_status_labels.each do |status| %>
                  <% service = status[:service] %>
                  <% display = AgencyConnection::DISPLAY.fetch(service) %>
                  <div class="group relative">
                    <span class="inline-flex items-center justify-center size-6 rounded text-xs font-semibold text-white cursor-help <%= status[:badge_class] %>">
                      <%= display[:letter] %>
                    </span>
                    <div class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 hidden group-hover:block bg-slate-900 text-white text-xs rounded px-2 py-1 whitespace-nowrap z-10">
                      <span><%= display[:name] %></span>
                      <br>
                      <span class="text-slate-300"><%= status[:label] %></span>
                    </div>
                  </div>
                <% end %>
              </div>
              <div>
                <p class="text-sm text-slate-900"><%= row.latest_report_label %></p>
                <p class="text-xs text-slate-500"><%= row.latest_report_sublabel %></p>
              </div>
              <span class="flex items-center gap-1.5 text-sm font-medium text-slate-700">
                <span class="size-2 shrink-0 rounded-full <%= row.delivery_dot_class %>"></span>
                <%= row.delivery_label %>
              </span>
            <% end %>
            <% if current_admin_user.admin? %>
              <!-- Desktop: Dropdown menu -->
              <div class="hidden sm:flex items-center justify-end" data-controller="client-menu">
                <button type="button" class="p-1.5 rounded text-slate-400 hover:bg-slate-200 hover:text-slate-700" data-client-menu-target="button">
                  <%= report_icon(:menu, css_class: "size-4") %>
                </button>
                <div class="hidden w-40 rounded-lg border border-slate-200 bg-white shadow-lg z-50" data-client-menu-target="menu">
                  <%= link_to client_path(client),
                        class: "flex items-center gap-2 px-4 py-2.5 text-sm text-slate-700 hover:bg-slate-50 first:rounded-t-lg" do %>
                    <%= report_icon(:eye, css_class: "size-4") %>
                    <span>View</span>
                  <% end %>
                  <% if !client.discarded? %>
                    <%= link_to edit_client_path(client),
                          class: "flex items-center gap-2 px-4 py-2.5 text-sm text-slate-700 hover:bg-slate-50 border-t border-slate-100" do %>
                      <%= report_icon(:file_text, css_class: "size-4") %>
                      <span>Edit</span>
                    <% end %>
                    <%= button_to client_path(client), method: :delete,
                          data: { turbo_confirm: "Offboard #{client.name}?" },
                          class: "offboard-btn flex items-center gap-2 px-4 py-2.5 text-sm border-t border-slate-100 last:rounded-b-lg w-full text-left" do %>
                      <%= report_icon(:arrow_up_right, css_class: "size-4") %>
                      <span>Offboard</span>
                    <% end %>
                  <% else %>
                    <%= button_to restore_client_path(client), method: :post,
                          data: { turbo_confirm: "⚠️ Warning: Recovering #{client.name} will make them visible again.\n\nHubSpot will automatically sync in ~1 hour. If they're still marked as offboarded in HubSpot, they will be hidden again.\n\nThis action is not recommended unless you've updated their status in HubSpot first.\n\nProceed?" },
                          class: "flex items-center gap-2 px-4 py-2.5 text-sm text-slate-700 hover:bg-slate-50 border-t border-slate-100 w-full text-left" do %>
                      <%= report_icon(:arrow_up_right, css_class: "size-4") %>
                      <span>Recover</span>
                    <% end %>
                    <style>
                      .delete-permanently-menu-btn {
                        color: #B91C1C;
                        transition-property: background-color;
                        transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
                        transition-duration: 150ms;
                      }
                      .delete-permanently-menu-btn:hover {
                        background-color: #FEE2E2;
                      }
                    </style>
                    <%= button_to client_path(client), method: :delete,
                          data: { turbo_confirm: "Permanently delete #{client.name}? This cannot be undone." },
                          class: "delete-permanently-menu-btn flex items-center gap-2 px-4 py-2.5 text-sm border-t border-slate-100 last:rounded-b-lg w-full text-left" do %>
                      <%= report_icon(:x, css_class: "size-4") %>
                      <span>Delete permanently</span>
                    <% end %>
                  <% end %>
                </div>
              </div>
              <!-- Mobile: Inline buttons -->
              <div class="sm:hidden flex items-center gap-1">
                <%= link_to client_path(client), class: "p-1.5 rounded text-slate-400 hover:bg-slate-200" do %>
                  <%= report_icon(:eye, css_class: "size-4") %>
                <% end %>
                <% if !client.discarded? %>
                  <%= link_to edit_client_path(client), class: "p-1.5 rounded text-slate-400 hover:bg-slate-200" do %>
                    <%= report_icon(:file_text, css_class: "size-4") %>
                  <% end %>
                  <%= button_to client_path(client), method: :delete,
                        data: { turbo_confirm: "Offboard #{client.name}?" },
                        class: "p-1.5 rounded text-slate-400 hover:bg-slate-200" do %>
                    <%= report_icon(:arrow_up_right, css_class: "size-4") %>
                  <% end %>
                <% else %>
                  <%= button_to client_path(client), method: :delete,
                        data: { turbo_confirm: "Permanently delete #{client.name}? This cannot be undone." },
                        class: "p-1.5 rounded text-red-600 hover:bg-red-100" do %>
                    <%= report_icon(:x, css_class: "size-4") %>
                  <% end %>
                <% end %>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <div class="mt-3 flex items-center justify-between text-sm text-slate-500">
    <span>Showing <%= @query.records.size %> of <%= @query.total_count %> practices</span>
    <div class="flex items-center gap-2">
      <%= link_to "Previous", clients_path(q: params[:q], status: @status, page: @query.page - 1),
            class: "rounded-lg border px-3 py-1.5 text-sm font-medium #{@query.page > 1 ? "border-slate-200 bg-white text-slate-700 hover:bg-slate-50" : "pointer-events-none border-slate-100 bg-white text-slate-300"}" %>
      <%= link_to "Next", clients_path(q: params[:q], status: @status, page: @query.page + 1),
            class: "rounded-lg border px-3 py-1.5 text-sm font-medium #{@query.page < @query.total_pages ? "border-slate-200 bg-white text-slate-700 hover:bg-slate-50" : "pointer-events-none border-slate-100 bg-white text-slate-300"}" %>
    </div>
  </div>
<% else %>
  <div class="rounded-xl border border-dashed border-slate-300 p-4 text-sm text-slate-600">
    <% if params[:q].present? || @status.present? %>
      No clients match that search.
    <% else %>
      No practices yet. <%= link_to "Add the first one", hubspot_search_clients_path, class: "font-medium text-teal-dark hover:underline" if current_admin_user.admin? %>
    <% end %>
  </div>
<% end %>
