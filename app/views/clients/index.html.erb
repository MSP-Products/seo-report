<% content_for :page_stylesheets do %>
  <%= stylesheet_link_tag "dashboard" %>
  <%= stylesheet_link_tag "clients" %>
<% end %>

<div class="page-wrapper">
  <%= render "shared/sidebar", active_nav: "clients" %>

  <div class="client-main">
    <div class="list-header-row">
      <div>
        <h1>Clients</h1>
        <p class="dashboard-subtitle">All client practices and their latest report status.</p>
      </div>
      <%= link_to "+ Add Client", new_client_path, class: "btn-primary" %>
    </div>

    <div class="list-toolbar">
      <input type="text" class="search-input" placeholder="Search clients...">
      <select class="filter-dropdown">
        <option>All Statuses</option>
      </select>
    </div>

    <div class="clients-table-card">
      <table class="clients-table">
        <thead>
          <tr>
            <th>Practice Name</th>
            <th>Onboarding</th>
            <th>Last Report</th>
            <th>Generation</th>
            <th>Send Status</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @clients.each do |client| %>
            <tr>
              <td><%= link_to client[:name], client_path(client[:id]), style: "color:#1a1a1a; text-decoration:none; font-weight:500;" %></td>
              <td><span class="badge <%= badge_class(client[:onboarding]) %>"><%= client[:onboarding] %></span></td>
              <td><%= client[:last_report] %></td>
              <td><span class="badge <%= badge_class(client[:generation]) %>"><%= client[:generation] %></span></td>
              <td>
                <% if client[:send_status] == "Sent" %>
                  <span class="send-status-sent">Sent<span class="send-status-date"><%= client[:sent_date] %></span></span>
                <% else %>
                  <span class="send-status-not-sent">Not Sent</span>
                <% end %>
              </td>
              <td>
                <%= link_to "View", client_path(client[:id]), class: "table-action-link" %>
                <%= link_to "Edit", "#", class: "table-action-link" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="table-footer-row">
      <span>Showing 1-<%= @clients.size %> of 47 clients</span>
      <div class="pagination">
        <%= link_to "Previous", "#" %>
        <span class="active-page">1</span>
        <%= link_to "2", "#" %>
        <%= link_to "3", "#" %>
        <span>...</span>
        <%= link_to "Next", "#" %>
      </div>
    </div>
  </div>
</div>