<% display = AgencyConnection::DISPLAY.fetch(@link.service) %>
<% content_for :title, "#{display[:name]} — #{@client.name}" %>

<div class="mb-6">
  <%= link_to "← #{@client.name}", client_data_sources_path(@client), class: "text-sm text-slate-500 hover:text-slate-700" %>
  <div class="mt-2 flex items-center gap-3">
    <div class="flex size-9 items-center justify-center rounded-lg <%= display[:badge_class] %> text-sm font-bold text-white">
      <%= display[:letter] %>
    </div>
    <h1 class="text-2xl font-semibold tracking-tight text-slate-900"><%= display[:name] %></h1>
  </div>
  <p class="mt-2 text-sm text-slate-500">
    The account or location ID this practice uses with <%= display[:name] %>. Leave blank to unlink it.
  </p>
</div>

<div class="max-w-md rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
  <%= form_with url: client_data_source_path(@client, @link.service), method: :patch, class: "space-y-5" do %>
    <%= render "shared/form_group", label: "Account / location ID", field_name: "client_service_link[external_id]",
          type: "text", value: @link.external_id, placeholder: "e.g. company-12345" %>

    <div class="flex items-center gap-3">
      <button type="submit" class="rounded-lg bg-teal-primary px-4 py-2 text-sm font-medium text-white hover:bg-teal-dark">
        Save
      </button>
      <%= link_to "Cancel", client_data_sources_path(@client), class: "text-sm text-slate-500 hover:text-slate-700" %>
    </div>
  <% end %>
</div>
