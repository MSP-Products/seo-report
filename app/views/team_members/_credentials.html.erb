<%# locals: admin_user (AdminUser) %>

<div class="mt-4">
  <%= render "shared/alert", type: "success",
        message: "Copy this password now — it won't be shown again anywhere in the app." %>
</div>

<div class="mt-4 max-w-md rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
  <dl class="space-y-4">
    <div>
      <dt class="text-xs font-medium uppercase text-slate-500">Email</dt>
      <dd class="mt-1 text-sm text-slate-900"><%= admin_user.email %></dd>
    </div>
    <div>
      <dt class="text-xs font-medium uppercase text-slate-500">Password</dt>
      <dd id="generated-password" class="mt-1 font-mono text-sm text-slate-900"><%= admin_user.generated_password %></dd>
    </div>
    <div>
      <dt class="text-xs font-medium uppercase text-slate-500">Role</dt>
      <dd class="mt-1 text-sm text-slate-900"><%= admin_user.role.name %></dd>
    </div>
  </dl>
</div>

<div class="mt-6">
  <%= link_to "Back to Team", team_members_path,
        class: "rounded-lg bg-teal-primary px-4 py-2 text-sm font-medium text-white hover:bg-teal-dark" %>
</div>
