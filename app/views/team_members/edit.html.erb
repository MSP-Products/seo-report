<% content_for :title, "Manage #{@admin_user.display_name} — My Social Practice" %>

<p class="mb-2 text-sm text-slate-500"><%= link_to "← Team", team_members_path, class: "hover:underline" %></p>

<h1 class="text-2xl font-semibold tracking-tight text-slate-900">Manage <%= @admin_user.display_name %></h1>

<% if @admin_user.errors.any? %>
  <div class="mt-4">
    <%= render "shared/alert", type: "error", message: "Couldn't update this member: #{@admin_user.errors.full_messages.to_sentence}." %>
  </div>
<% end %>

<%= form_with model: @admin_user, url: team_member_path(@admin_user), method: :patch, class: "mt-6 space-y-6" do %>
  <div class="max-w-md rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
    <h2 class="font-medium text-slate-900">Details</h2>

    <div class="mt-4 space-y-4">
      <%= render "shared/form_group", label: "Email", field_name: "admin_user[email]", type: "email",
            value: @admin_user.email, has_error: @admin_user.errors[:email].any? %>

      <div class="grid grid-cols-2 gap-4">
        <%= render "shared/form_group", label: "First name", field_name: "admin_user[first_name]", type: "text",
              value: @admin_user.first_name %>
        <%= render "shared/form_group", label: "Last name", field_name: "admin_user[last_name]", type: "text",
              value: @admin_user.last_name %>
      </div>

      <div class="flex flex-col gap-2">
        <label for="admin_user_role_id" class="text-sm font-medium text-gray-700">Role</label>
        <select name="admin_user[role_id]" id="admin_user_role_id"
          class="w-full rounded-lg border-[1.5px] border-gray-300 bg-gray-50 px-4 py-3 text-sm text-gray-800 outline-none transition-all duration-150 focus:border-teal-600 focus:bg-white focus:ring-3 focus:ring-teal-600/15">
          <% current_admin_user.assignable_roles.each do |role| %>
            <option value="<%= role.id %>" <%= "selected" if @admin_user.role_id == role.id %>><%= role.name %></option>
          <% end %>
        </select>
      </div>
    </div>
  </div>

  <div class="flex items-center gap-3">
    <button type="submit" class="rounded-lg bg-teal-primary px-4 py-2 text-sm font-medium text-white hover:bg-teal-dark">
      Save changes
    </button>
    <%= link_to "Cancel", team_members_path, class: "text-sm text-slate-500 hover:text-slate-700" %>
  </div>
<% end %>
